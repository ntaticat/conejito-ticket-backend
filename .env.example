# Copiar a .env: cp .env.example .env
# Los valores por defecto coinciden con ConnectionStrings:Default de appsettings.json.
# Si los cambias, sobrescribe la conexión del API, p. ej.:
#   ConnectionStrings__Default="Host=localhost;Port=5433;Database=...;Username=...;Password=..."
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=conejito_ticket
POSTGRES_PORT=5432

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:usuario@correo.com